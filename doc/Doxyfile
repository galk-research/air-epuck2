#---------------------------------------------------------------------------
# Doxygen configuration file (Doxyfile)
#
# How to build (from repo root):
#   cd doc && doxygen Doxyfile
#
# Output:
#   doc/html/index.html
#---------------------------------------------------------------------------

DOXYFILE_ENCODING      = UTF-8

#---------------------------------------------------------------------------
# Project
#---------------------------------------------------------------------------

PROJECT_NAME           = "ARGoS Air Resistance / Wind Plugins"
PROJECT_BRIEF          = "Wind + wake / blocking plugins and controllers for ARGoS"
PROJECT_NUMBER         =
OUTPUT_LANGUAGE        = English
OUTPUT_TEXT_DIRECTION  = None

# Use README as the landing page of the HTML docs
MARKDOWN_SUPPORT       = YES
USE_MDFILE_AS_MAINPAGE = ../README.md

#---------------------------------------------------------------------------
# Build / output locations
#---------------------------------------------------------------------------

# Put generated files under doc/ (next to this Doxyfile)
OUTPUT_DIRECTORY       = .
CREATE_SUBDIRS         = NO

#---------------------------------------------------------------------------
# Input
#---------------------------------------------------------------------------

# Scan: core code + tutorial controllers + README
INPUT                  = ../src \
                         ../examples/controllers \
                         ../README.md

INPUT_ENCODING         = UTF-8
RECURSIVE              = YES

# File types to parse (include *.md so markdown pages are included)
FILE_PATTERNS          = *.c \
                         *.cc \
                         *.cxx \
                         *.cpp \
                         *.c++ \
                         *.h \
                         *.hh \
                         *.hxx \
                         *.hpp \
                         *.h++ \
                         *.ipp \
                         *.inl \
                         *.md

# Ignore build artifacts if they ever appear inside INPUT folders
EXCLUDE_PATTERNS       = */build/* \
                         */CMakeFiles/* \
                         */cmake-build-*/*

#---------------------------------------------------------------------------
# Extraction / visibility
#---------------------------------------------------------------------------

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_LOCAL_METHODS  = NO

HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

#---------------------------------------------------------------------------
# Warnings
#---------------------------------------------------------------------------

QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
WARN_FORMAT            = "$file:$line: $text"
WARN_LOGFILE           =

#---------------------------------------------------------------------------
# Input preprocessing
#---------------------------------------------------------------------------

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = NO
EXPAND_ONLY_PREDEF     = NO
SEARCH_INCLUDES        = YES

#---------------------------------------------------------------------------
# Source browsing
#---------------------------------------------------------------------------

SOURCE_BROWSER         = NO
INLINE_SOURCES         = NO

#---------------------------------------------------------------------------
# HTML output
#---------------------------------------------------------------------------

GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
GENERATE_TREEVIEW      = NO
DISABLE_INDEX          = NO
SEARCHENGINE           = YES

#---------------------------------------------------------------------------
# Other output formats (off)
#---------------------------------------------------------------------------

GENERATE_LATEX         = NO
GENERATE_RTF           = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO
GENERATE_DOCBOOK       = NO

#---------------------------------------------------------------------------
# Paths / names
#---------------------------------------------------------------------------

FULL_PATH_NAMES        = NO
STRIP_FROM_PATH        =
STRIP_FROM_INC_PATH    =

#---------------------------------------------------------------------------
# Dot / Graphviz (class/inheritance/include graphs)
#---------------------------------------------------------------------------

HAVE_DOT               = YES
DOT_PATH               =
CLASS_DIAGRAMS         = YES
UML_LOOK               = NO
TEMPLATE_RELATIONS     = NO
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
GRAPHICAL_HIERARCHY    = YES
DIRECTORY_GRAPH        = YES
DOT_GRAPH_MAX_NODES    = 50
MAX_DOT_GRAPH_DEPTH    = 0
DOT_TRANSPARENT        = NO

# Keep call graphs off unless you really want them (can get heavy)
CALL_GRAPH             = NO
CALLER_GRAPH           = NO

#---------------------------------------------------------------------------
# End
#---------------------------------------------------------------------------

